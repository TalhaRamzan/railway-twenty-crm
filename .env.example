# .env.example for LOCAL testing with docker-compose.yml.
# Copy to .env and fill in every empty secret. Never commit .env.
#
# On Railway you do NOT use this file: the template generates every secret with
# ${{secret(...)}} and wires the rest with reference variables
# (see railway-template.md).

# --- Public URL -------------------------------------------------------------
# Must be the exact URL users open in the browser (scheme + host, no trailing slash).
# Railway: https://${{RAILWAY_PUBLIC_DOMAIN}} (or your custom domain).
SERVER_URL=http://localhost:3000

# --- Secrets (generate each one separately) -----------------------------------
# openssl rand -base64 32
# ENCRYPTION_KEY encrypts secrets stored in the DB (OAuth tokens, 2FA secrets...).
# Losing it means losing access to those secrets. Back it up.
ENCRYPTION_KEY=
# openssl rand -base64 32
# Legacy app secret. Twenty falls back to it when ENCRYPTION_KEY is unset.
# We set both so the template works across Twenty versions.
APP_SECRET=

# --- Postgres -----------------------------------------------------------------
PG_USER=postgres
# openssl rand -hex 24   (hex only: it goes into the connection URL as-is)
PG_PASSWORD=
PG_DB=twenty

# --- Redis --------------------------------------------------------------------
# openssl rand -hex 24
REDIS_PASSWORD=

# --- S3 bucket (local SeaweedFS stand-in for the Railway bucket) ---------------
S3_BUCKET=twenty-files
S3_REGION=us-east-1
# openssl rand -hex 10
S3_ACCESS_KEY_ID=
# openssl rand -hex 20
S3_SECRET_ACCESS_KEY=

# --- Email --------------------------------------------------------------------
# Twenty v2.60.1 supports only two email drivers: "logger" (emails are written
# to the logs, nothing is sent) and "smtp". There is no HTTP-API driver.
# Railway Free/Trial/Hobby plans block outbound SMTP, so keep "logger" there.
# On Railway Pro, use an SMTP relay such as Resend, Postmark, Brevo or SES.
EMAIL_DRIVER=logger
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_FROM_NAME=Twenty CRM
# Example (Resend): host smtp.resend.com, port 465, user "resend", password = API key
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
